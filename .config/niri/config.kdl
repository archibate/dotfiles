// niri config — mirrors 小彭老师's i3 muscle memory onto scrollable-tiling.
// KDL format. Wiki: https://niri-wm.github.io/niri/
// niri auto-reloads this file on save — no reload/restart keybind needed.
// Validate with: niri validate

input {
    keyboard {
        xkb {
            // layout "us"  // fetched from localectl if empty
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        // accel-speed 0.0
    }
    // i3 had focus_follows_mouse on by default; keep it.
    focus-follows-mouse max-scroll-amount="34%"
    // warp-mouse-to-focus mode="center-xy"
    // Super+mouse to move/resize floating windows (like i3 floating_modifier $mod).
    mod-key "Super"
    // Switching to the same workspace by index twice will switch back to the previous workspace.
    workspace-auto-back-and-forth
}

// Session environment (replaces .xprofile, which niri never sources).
// Inherited by every app niri spawns, including XWayland children.
environment {
    // Proxy for GUI apps (chromium etc.); shell keeps its own via fish.
    http_proxy "http://127.0.0.1:7890"
    https_proxy "http://127.0.0.1:7890"
    all_proxy "http://127.0.0.1:7890"
    no_proxy "localhost,127.0.0.1,api.deepseek.com,api.ofox.io,142857.red"
    // XWayland/X11 apps read this to reach fcitx's XIM server. Wayland-native
    // apps use the text-input protocol and need no IME env var.
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    // Preferred terminal for XDG launchers.
    TERMINAL "kitty"
    EDITOR "nvim"
}

// Outputs are managed dynamically by kanshi (see ~/.config/kanshi/config):
// Xiaomi HDMI present → laptop eDP-1 off; Xiaomi unplugged → eDP-1 on.
// This replaces a static `output "eDP-1" { off }` so the laptop still works solo.

layout {
    gaps 12
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-gradient from="#7aa2f7" to="#bb9af7" angle=45
        inactive-color "#505050"
    }
    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000070"
    }
}

// i3 has no client-side decorations; ask apps to drop CSD for clean borders.
prefer-no-csd

screenshot-path "~/Pictures/screenshot/Screenshot-%Y%m%d_%H%M%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    // off
}

// Rounded corners for all windows; clip content so corners actually round.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Firefox picture-in-picture floats (from default config).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Indicate screencasted windows with red colors.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

// Blur behind windows (niri-native, replaces picom). Shows through transparent
// windows like kitty (background_opacity 0.8). xray false = real blur of whatever
// is behind, matching picom; it's experimental and glitches during open/close
// animations — flip to `xray true` for the stable (wallpaper-only) blur.
window-rule {
    background-effect {
        blur true
        xray false
        noise 0.03
        saturation 1.2
    }
}

// ---- Autostart (replaces i3 `autostart` file; X11 bits dropped) ----
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-i" "/home/bate/.config/i3/ina.png" "-m" "fill"
// dex handles XDG autostart .desktop entries, same as under i3.
spawn-at-startup "dex" "--autostart" "--environment" "niri"
// kanshi applies the right monitor profile (docked vs laptop) on start & hotplug.
spawn-at-startup "kanshi"
// niri 26.04 spawns xwayland-satellite itself and sets DISPLAY for children —
// just having the binary installed is enough. No manual spawn / DISPLAY needed.

// Recent Windows switcher (niri-native Alt+Tab-style). Defining binds here removes
// niri's default Alt+Tab/Alt+grave binds — moving the whole feature onto Mod+.
recent-windows {
    binds {
        Mod+Tab       { next-window; }
        Mod+Shift+Tab { previous-window; }
    }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ---- Launch (your i3 app keys) ----
    Mod+Return { spawn "kitty"; }
    Mod+Space  { spawn "fuzzel"; }              // i3: rofi drun. fuzzel is Wayland-native.
    Mod+B { spawn "chromium"; }
    Mod+O { spawn "thunar"; }
    Super+Alt+L { spawn "swaylock"; }
    // Keyboard-driven mouse warp (wl-kbptr, replaces warpd): tile-label then bisect.
    Mod+Semicolon { spawn "wl-kbptr"; }

    // ---- Window / column ----
    Mod+D repeat=false { close-window; }        // i3: $mod+d = kill

    // Focus (i3 hjkl). j/k step within a column, then fall through to the
    // next/prev workspace when there's no stacked window; h/l between columns,
    // wrapping around at the left/right end.
    Mod+H { focus-column-left-or-last; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right-or-first; }
    Mod+Left  { focus-column-left-or-last; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right-or-first; }

    // Move (i3 Shift+hjkl). j/k carry the window across the workspace edge too.
    // (niri has no move-column wrap action, so h/l stop at the ends.)
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }

    // Jump to / move column to the ends of the scroll strip (Home=first like H, End=last like L).
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Merge a window into / expel it out of the column to the side (niri's native gesture).
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ---- Sizing (i3 resize mode → direct keys) ----
    Mod+R { switch-preset-column-width; }        // cycle 1/3, 1/2, 2/3
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ---- Layout state ----
    Mod+Z { fullscreen-window; }                 // i3: $mod+z fullscreen
    Mod+Shift+Z { toggle-windowed-fullscreen; }
    Mod+F { maximize-column; }
    Mod+W { toggle-window-floating; }            // i3: $mod+w floating toggle
    Mod+Shift+W { switch-focus-between-floating-and-tiling; }
    Mod+T { toggle-column-tabbed-display; }      // i3: $mod+t tabbed
    Mod+C { center-column; }

    // Overview: zoomed-out view of workspaces/windows (use as window switcher).
    Mod+Grave repeat=false { toggle-overview; }

    // ---- Workspaces (i3 1..0, dynamic & vertical in niri) ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Scroll workspaces (niri is vertical) and columns.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    // Reorder the current workspace — swaps it with the neighbor.
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Multi-monitor (niri default keys, moved off Shift+hjkl which we reused).
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // ---- Media / brightness (Wayland-native; needs wireplumber + brightnessctl) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // ---- Screenshots (niri built-in; replaces flameshot, which is X11) ----
    Print { screenshot-screen; }                 // i3: flameshot full
    Shift+Print { screenshot; }                  // i3: flameshot gui (interactive region)
    Alt+Print { screenshot-window; }

    // ---- Session ----
    Mod+Shift+E { quit; }                         // shows a confirm dialog
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

// Force niri to render on the NVIDIA RTX 2080 (card1, PCI 01:00.0) instead of
// Intel UHD 630. HDMI is wired to NVIDIA; rendering on Intel forced a cross-GPU
// copy every frame -> ~40fps cap. See eglinfo before/after.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
}
