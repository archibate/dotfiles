#!/usr/bin/env bash
# Open a URL from a kitty hint.
# For file://host/path with a remote netloc, scp the file locally first;
# empty netloc or localhost means the file is already local.
# Local text files are opened with nvim in a new kitty window (xdg-open
# would route them through a Terminal=true .desktop entry that hangs
# under i3). Everything else goes through xdg-open, detached.
set -euo pipefail
log=~/.cache/kitty-open-action.log
tmp_dir=/tmp/kitty-open-remote-image
mkdir -p "$(dirname "$log")" "$tmp_dir"
url="$1"
{ echo "--- $(date) ---"; echo "url=$url"; } >>"$log"
case "$url" in
    file://*)
        rest="${url#file://}"
        netloc="${rest%%/*}"
        path="/${rest#*/}"
        echo "netloc=$netloc path=$path" >>"$log"
        if [ -z "$netloc" ] || [ "$netloc" = "localhost" ]; then
            target="$path"
        else
            target="$tmp_dir/$(basename "$path")"
            scp -q "${netloc}:${path}" "$target" >>"$log" 2>&1
            echo "scp_exit=$? target=$target" >>"$log"
        fi
        ;;
    *)
        target="$url"
        ;;
esac
if [ -f "$target" ] && file --mime-type -b "$target" | grep -q '^text/'; then
    setsid -f kitty nvim "$target" </dev/null >>"$log" 2>&1
    echo "opened_in_kitty_nvim" >>"$log"
else
    setsid -f xdg-open "$target" </dev/null >>"$log" 2>&1
    echo "xdg_open_dispatched" >>"$log"
fi
