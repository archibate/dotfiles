#!/usr/bin/env bash
# Open a remote file:// URL: scp from the URL netloc, then xdg-open locally.
# Empty netloc (file:///path) means the file is already on this machine — skip
# scp and hand the path straight to xdg-open.
set -euo pipefail
log=~/.cache/kitty-open-action.log
tmp_dir=/tmp/kitty-open-remote-image
mkdir -p "$(dirname "$log")" "$tmp_dir"
url="$1"
rest="${url#file://}"
netloc="${rest%%/*}"
path="/${rest#*/}"
{ echo "--- $(date) ---"; echo "url=$url netloc=$netloc path=$path"; } >>"$log"
if [ -z "$netloc" ]; then
    target="$path"
else
    target="$tmp_dir/$(basename "$path")"
    scp -q "${netloc}:${path}" "$target" >>"$log" 2>&1
    echo "scp_exit=$? target=$target" >>"$log"
fi
xdg-open "$target" >>"$log" 2>&1
echo "xdg_exit=$?" >>"$log"
