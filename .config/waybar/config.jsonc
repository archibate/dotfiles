// waybar for niri — mirrors 小彭老师's polybar layout & modules.
// Icons are raw UTF-8 Nerd Font glyphs (codepoints verified present in JetBrainsMono Nerd Font).
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["mpris"],
    "modules-right": ["disk", "custom/earbuds", "pulseaudio", "cpu", "memory", "custom/gpu", "battery", "network", "clock", "tray"],

    "niri/workspaces": {
        "format": "{index}"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // Click play/pause · middle previous · right next (built-in defaults).
    "mpris": {
        "player": "vlc",
        "format": "{status_icon} {dynamic}",
        "status-icons": { "playing": "", "paused": "", "stopped": "" },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 50,
        "tooltip-format": "{title}\n{artist} · {album}\n{length}"
    },

    "disk": {
        "interval": 30,
        "format": " {percentage_used:3}%",
        "path": "/",
        "states": { "warning": 80, "critical": 95 },
        "tooltip-format": "{used} used / {total} ({free} free) on {path}"
    },

    "pulseaudio": {
        "format": "{icon} {volume:3}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    "custom/earbuds": {
        "exec": "earbuds-pc status",
        "return-type": "json",
        "interval": 4,
        "signal": 8,
        "on-click": "earbuds-pc toggle"
    },

    "cpu": {
        "interval": 1,
        "format": " {usage:3}%",
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "CPU {usage}% · {load} load avg",
        "on-click": "kitty -e btm --process_default_sort cpu%"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage:3}%",
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used",
        "on-click": "kitty -e btm --process_default_sort mem%"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "kitty -e nvtop"
    },

    "battery": {
        "interval": 10,
        "bat": "BAT0",
        "adapter": "AC0",
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity:3}%",
        "format-charging": " {capacity:3}%",
        "format-plugged": " {capacity:3}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "network": {
        "format-wifi": " {signalStrength:3}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " off",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "kitty -e impala"
    },

    "clock": {
        "format": " {:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
