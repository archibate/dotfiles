// waybar for niri — mirrors 小彭老师's polybar layout & modules.
// Icons are raw UTF-8 Nerd Font glyphs (codepoints verified present in JetBrainsMono Nerd Font).
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": [],
    "modules-right": ["disk", "pulseaudio", "cpu", "memory", "battery", "network", "clock", "tray"],

    "niri/workspaces": {
        "format": "{index}"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "disk": {
        "interval": 30,
        "format": " {percentage_used:3}%",
        "path": "/",
        "states": { "warning": 80, "critical": 95 },
        "tooltip-format": "{used} used / {total} ({free} free) on {path}"
    },

    "pulseaudio": {
        "format": "{icon} {volume:3}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage:3}%",
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "CPU {usage}% · {load} load avg"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage:3}%",
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used"
    },

    "battery": {
        "interval": 10,
        "bat": "BAT0",
        "adapter": "AC0",
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity:3}%",
        "format-charging": " {capacity:3}%",
        "format-plugged": " {capacity:3}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "network": {
        "format-wifi": " {signalStrength:3}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " off",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "clock": {
        "format": " {:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
